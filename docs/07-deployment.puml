@startuml deployment
skinparam backgroundColor #FDFCFB
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Helvetica, Arial, sans-serif
skinparam defaultFontSize 11
skinparam defaultFontColor #1E293B

header
<font size="12" color="#D97706"><b>Лоиҳа: Biyomuz Academy</b></font><font size="12" color="#64748B">  |  Диаграммаи ҷойгиршавӣ (Deployment Diagram)</font>
endheader

title
<font size="22" color="#0F172A"><b>Диаграммаи ҷойгиршавӣ (Deployment Diagram)</b></font>
<font size="12" color="#475569">Меъмории система дар муҳити истеҳсолии Linux VDS ва муҳити таҳияи XAMPP</font>
endtitle

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
  BorderThickness 1.8
  FontColor #0F172A
  FontSize 12
  FontStyle bold
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
  BorderThickness 1.8
  FontColor #0F172A
  FontSize 12
  FontStyle bold
}

skinparam folder {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  BorderThickness 1.5
  FontColor #0F172A
}

skinparam artifact {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  FontColor #1E293B
  FontSize 11
}

skinparam arrow {
  Color #2563EB
  Thickness 1.6
  FontColor #334155
  FontSize 10
}

' 1. Гиреҳи муштарӣ (Client)
node "Компютер / Смартфони корбар (Client)" as client {
  node "Браузери веб\n(Chrome / Firefox / Edge / Safari)" as browser
}

' 2. Сервери мақсаднок (Production Linux VDS)
node "Linux VDS (Ubuntu 24.04 LTS) [Сервери истеҳсолӣ]" as vds {
  
  node "Nginx 1.24+ (Web Server & Reverse Proxy)" as nginx {
    artifact "deploy/nginx.conf\n(Танзимоти веб-сервер)" as nconf
    artifact "public/assets/\n(CSS, JS, WebFonts, Images)" as assets
  }

  node "PHP-FPM 8.5 (FastCGI Process Manager)" as fpm {
    artifact "biyomuz-academy/\npublic/index.php" as app_index
    artifact "app/, routes/, resources/\nvendor/ (Laravel 13 Core)" as app_core
    artifact ".env\n(Танзимоти пайвастшавии база)" as env_cfg
  }

  database "MariaDB 10.4+ / MySQL 8.0\nkurskhoi_online (utf8mb4)" as db {
    artifact "10 ҷадвали релятсионии соҳавӣ\n(users, courses, modules, lessons,\nenrollments, assignments, submissions,\ncertificates, lesson_progress, categories)" as tables
  }

  folder "storage/app/public/\n(Файлҳои дарсҳо, супоришҳо ва сертификатҳои PDF)" as storage
}

' 3. Муҳити таҳияи маҳаллӣ (Development Environment)
node "Муҳити таҳияи маҳаллӣ (Windows 11 / XAMPP) [Development Node]" as local_dev {
  node "Веб-сервери маҳаллӣ\n(Apache 2.4 / Nginx)" as local_web
  node "PHP 8.5 CLI / Модул\n(Laravel 13 Application)" as local_app
  database "MariaDB 10.4.32\nkurskhoi_online (utf8mb4)" as local_db
}

' Робитаҳо ва протоколҳои шабакавӣ
browser --> nginx : HTTPS :443 / HTTP :80\n(TLS 1.3 / Рамзгузории SSL)
nginx --> fpm : FastCGI (unix-сокет)\n/run/php/php8.5-fpm.sock
fpm --> db : TCP 127.0.0.1:3306\n(Пайвастшавии маҳаллии PDO MariaDB)
fpm ..> storage : Сабти файлҳо ва тавлиди PDF (Local FS)
nginx ..> storage : Пешниҳоди мустақими статика (HTTP static)

' Робитаҳо дар муҳити маҳаллӣ
browser ..> local_web : HTTP TCP :80 / TCP :8000\n(Дархости таҳиягар)
local_web --> local_app : Иҷрои скриптҳои PHP
local_app --> local_db : TCP 127.0.0.1:3306\n(Пайвастшавии PDO MySQL)

note bottom of vds
  <b>Қоидаи амният:</b>
  Пойгоҳи додаҳои MariaDB танҳо ба суроғаи маҳаллии 127.0.0.1 гӯш медиҳад.
  Дастрасии мустақим аз шабакаи беруна баста шудааст.
end note

note bottom of local_dev
  <b>Муҳити ҷории корӣ:</b>
  Дар компютери таҳиягар муҳити XAMPP бо MariaDB 10.4 фаъол буда,
  пойгоҳи додаҳои <b>kurskhoi_online</b> бо ҳамаи 10 ҷадвал амал мекунад.
end note

@enduml
