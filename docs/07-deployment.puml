@startuml deployment
skinparam backgroundColor #FDFCFB
skinparam roundcorner 10
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Helvetica, Arial, sans-serif
skinparam defaultFontSize 11
skinparam defaultFontColor #1E293B

header
<font size="12" color="#D97706"><b>Лоиҳа: Biyomuz Academy</b></font><font size="12" color="#64748B">  |  Диаграммаи ҷойгиршавӣ (Deployment Diagram)</font>
endheader

title
<font size="22" color="#0F172A"><b>Диаграммаи ҷойгиршавӣ (Deployment Diagram)</b></font>
<font size="12" color="#475569">Меъмории пешбинишудаи Production (Linux VDS) ва муҳити воқеии Development (XAMPP)</font>
endtitle

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
  BorderThickness 1.8
  FontColor #0F172A
  FontSize 12
  FontStyle bold
}

skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #1E3A8A
  BorderThickness 1.8
  FontColor #0F172A
  FontSize 12
  FontStyle bold
}

skinparam folder {
  BackgroundColor #F8FAFC
  BorderColor #2563EB
  BorderThickness 1.5
  FontColor #0F172A
}

skinparam artifact {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  FontColor #1E293B
  FontSize 11
}

skinparam arrow {
  Color #2563EB
  Thickness 1.6
  FontColor #334155
  FontSize 10
}

skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #CA8A04
  FontColor #713F12
  FontSize 10
}

' 1. Гиреҳи корбар (Client)
node "Компютер / Смартфони корбар (Client)" as client {
  node "Браузери веб\n(Chrome / Firefox / Edge / Safari)" as browser
}

' 2. Сервери мақсаднок (Production Linux VDS - Меъмории пешбинишуда)
node "Linux VDS (Ubuntu 24.04 LTS) [Меъмории пешбинишудаи Production]" as vds {
  
  node "Nginx 1.24+ (Web Server & Reverse Proxy)" as nginx {
    artifact "deploy/nginx.conf\n(Танзимоти веб-сервер)" as nconf
    artifact "public/assets/\n(CSS, JS, WebFonts, Images)" as assets
    artifact "public/storage/\n(Пайванди рамзии symbolic link)" as pub_storage
  }

  node "PHP-FPM 8.5 (FastCGI Process Manager)" as fpm {
    artifact "biyomuz-academy/\npublic/index.php" as app_index
    artifact "app/, routes/, resources/\nvendor/ (Laravel 13 Core)" as app_core
    artifact ".env\n(Танзимоти махфии пайвастшавӣ)" as env_cfg
  }

  folder "storage/app/public/\n(Файлҳои дарсҳо, супоришҳо ва сертификатҳои PDF)" as storage

  database "MariaDB Server (Меъмории пешбинишудаи LTS)\nkurskhoi_online (utf8mb4)" as db {
    artifact "10 ҷадвали релятсионии соҳавӣ:\n1. users\n2. categories\n3. courses\n4. modules\n5. lessons\n6. enrollments\n7. assignments\n8. assignment_submissions\n9. certificates\n10. lesson_progress" as tables
  }
}

' 3. Муҳити таҳияи маҳаллӣ (Windows 11 / XAMPP - Муҳити воқеии санҷидашуда)
node "Муҳити таҳияи маҳаллӣ (Windows 11 / XAMPP) [Development Node]" as local_dev {
  node "Веб-сервери Apache 2.4.58 (порт 80)\n[Модули Apache: PHP 8.2.12 mod_php]" as local_web
  node "Муҳити PHP 8.5.10 CLI (WinGet PATH)\n(Laravel 13 Core, Artisans, Мигратсияҳо)" as local_app
  database "MariaDB 10.4.32 (СУБД-и воқеии санҷидашуда)\nkurskhoi_online (utf8mb4)" as local_db {
    artifact "10 ҷадвали воқеии соҳавӣ:\n1. users\n2. categories\n3. courses\n4. modules\n5. lessons\n6. enrollments\n7. assignments\n8. assignment_submissions\n9. certificates\n10. lesson_progress" as local_tables
  }
}

' Робитаҳо ва протоколҳои шабакавӣ дар Production
browser --> nginx : HTTPS TCP :443\n(TLS 1.2/1.3, Рамзгузории трафик)
browser ..> nginx : HTTP TCP :80\n(Redirect 301 ба HTTPS)

nginx -down-> fpm : FastCGI (unix-сокет)\n/run/php/php8.5-fpm.sock
pub_storage -down-> storage : Пайванди рамзӣ (ln -s)
fpm -right-> storage : Сабти файлҳо ва тавлиди PDF (Local FS)
fpm -down-> db : TCP 127.0.0.1:3306\n(Пайвастшавии PDO MySQL: pdo_mysql)

' Робитаҳо дар муҳити таҳияи маҳаллӣ (Development)
browser ..> local_web : HTTP TCP :80\n(Веб-сервери Apache)
local_web -down-> local_app : Коркарди дархостҳо ва иҷрои скриптҳо
local_app -down-> local_db : TCP 127.0.0.1:3306\n(Пайвастшавии PDO MySQL: pdo_mysql)

note bottom of db
  <b>Қоидаи амният (Security Policy):</b>
  • Сервери MariaDB дар Production танҳо дар суроғаи маҳаллии 127.0.0.1:3306 фаъол карда мешавад.
  • Дастрасии мустақим аз шабакаи беруна ба порти СУБД комилан баста аст.
  • Пайвасти Laravel бо пойгоҳи додаҳо тавассути драйвери расмии <b>PDO MySQL (pdo_mysql)</b> иҷро мешавад.
  • Ин драйвер (pdo_mysql) стандарти PHP барои пайвастшавӣ ба сервери MariaDB мебошад.
  • Пайвасти Nginx бо PHP-FPM тавассути сокети маҳаллии FastCGI сурат мегирад.
  • Мубодилаи маълумот танҳо тавассути протоколи амни TLS 1.2/1.3 иҷро мешавад.
end note

note bottom of local_db
  <b>Муҳити таҳияи маҳаллӣ (Development):</b>
  • Системаи амалиётии Windows 11 бо бастаи XAMPP.
  • Веб-сервер: Apache 2.4.58 (порти 80) бо модули <b>PHP 8.2.12 (mod_php)</b>.
  • Сатри фармон: <b>PHP 8.5.10 CLI</b> (WinGet) барои иҷрои Laravel 13 ва Artisans.
  • Драйвери пойгоҳи додаҳо: <b>PDO MySQL (pdo_mysql)</b>.
  • СУБД-и воқеии санҷидашуда: <b>MariaDB 10.4.32</b> (порти 3306).
  • Пойгоҳи додаҳои лоиҳа: <b>kurskhoi_online</b> (рамзгузории utf8mb4).
  • Ҳамаи 10 ҷадвали соҳавӣ дар муҳити маҳаллӣ бе хато амал мекунанд.
end note

@enduml
